using Microsoft.AspNetCore.Authentication.JwtBearer;
using Microsoft.AspNetCore.RateLimiting;
using Microsoft.AspNetCore.StaticFiles;
using Microsoft.Extensions.FileProviders;
using System.Threading.RateLimiting;

var builder = WebApplication.CreateBuilder(args);

// DB
var connectionString = builder.Configuration.GetConnectionString("Supabase");
builder.Services.AddScoped<IGameDB>(_ => new DapperGameDB(connectionString));

// Admin reorder/raw SQL용 NpgsqlConnection (request scope, 자동 dispose)
builder.Services.AddScoped<Npgsql.NpgsqlConnection>(_ =>
{
    var conn = new Npgsql.NpgsqlConnection(connectionString);
    conn.Open();
    return conn;
});

// Controllers (public fields 직렬화 활성화)
builder.Services.AddControllers()
    .AddJsonOptions(o => o.JsonSerializerOptions.IncludeFields = true);

// Auth
builder.Services.AddAuthentication(JwtBearerDefaults.AuthenticationScheme)
    .AddJwtBearer(options =>
    {
        options.Authority = builder.Configuration["Supabase:AuthUrl"];
        options.TokenValidationParameters = new Microsoft.IdentityModel.Tokens.TokenValidationParameters
        {
            ValidateAudience = false,
            NameClaimType = "sub"
        };
        options.MapInboundClaims = false;
        options.Events = new Microsoft.AspNetCore.Authentication.JwtBearer.JwtBearerEvents
        {
            OnAuthenticationFailed = ctx =>
            {
                Console.WriteLine($"[Auth] FAILED: {ctx.Exception.GetType().Name}: {ctx.Exception.Message}");
                return Task.CompletedTask;
            },
            OnTokenValidated = ctx =>
            {
                Console.WriteLine($"[Auth] OK: {ctx.Principal?.FindFirst("sub")?.Value}");
                return Task.CompletedTask;
            }
        };
    });

// Rate Limiting (유저별, 어드민 면제)
builder.Services.AddRateLimiter(options =>
{
    options.RejectionStatusCode = 429;
    options.GlobalLimiter = PartitionedRateLimiter.Create<HttpContext, string>(context =>
    {
        if (context.Request.Path.StartsWithSegments("/admin/api"))
            return RateLimitPartition.GetNoLimiter("admin");

        var userId = context.User?.FindFirst("sub")?.Value
                  ?? context.Connection.RemoteIpAddress?.ToString()
                  ?? "anonymous";

        return RateLimitPartition.GetFixedWindowLimiter(userId, _ =>
            new FixedWindowRateLimiterOptions
            {
                PermitLimit = 100,
                Window = TimeSpan.FromMinutes(1)
            });
    });
});

// Response Compression
builder.Services.AddResponseCompression();

// Management API 프록시용
builder.Services.AddHttpClient();

var app = builder.Build();

// Auto Migration
{
    var migrationDir = Path.Combine(AppContext.BaseDirectory, "Migrations");
    if (Directory.Exists(migrationDir))
    {
        using var conn = new Npgsql.NpgsqlConnection(connectionString);
        conn.Open();
        foreach (var sqlFile in Directory.GetFiles(migrationDir, "*.sql").OrderBy(f => f))
        {
            try
            {
                var sql = File.ReadAllText(sqlFile);
                using var cmd = new Npgsql.NpgsqlCommand(sql, conn);
                cmd.ExecuteNonQuery();
                Console.WriteLine($"[Migration] {Path.GetFileName(sqlFile)} OK");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Migration] {Path.GetFileName(sqlFile)} FAIL: {ex.Message}");
            }
        }
    }
}

app.UseResponseCompression();
app.UseAuthentication();
app.UseAuthorization();
app.UseRateLimiter();

// Admin 정적 파일 서빙
var adminPath = Path.Combine(AppContext.BaseDirectory, "admin");
if (Directory.Exists(adminPath))
{
    app.UseStaticFiles(new StaticFileOptions
    {
        FileProvider = new PhysicalFileProvider(adminPath),
        RequestPath = "/admin",
        // 번들 파일명이 index.js 로 고정이라(ADR-0003 결정 3 — 해시 없음)
        // 헤더가 없으면 브라우저가 옛 사본을 계속 쓴다. 배포해도 화면이 안 바뀐다.
        // no-cache 는 "쓰지 마라" 가 아니라 "쓰기 전에 물어봐라" 다 —
        // ETag 가 이미 붙어 있어 안 바뀌었으면 304 로 끝난다.
        OnPrepareResponse = ctx =>
        {
            ctx.Context.Response.Headers.CacheControl = "no-cache, must-revalidate";
        }
    });
    // /admin → /admin/index.html 리다이렉트
    app.MapGet("/admin", (HttpContext ctx) =>
    {
        ctx.Response.Redirect("/admin/index.html");
        return Task.CompletedTask;
    });
}

// Admin API 인증 미들웨어 (admin_users 테이블 기반)
app.Use(async (context, next) =>
{
    if (context.Request.Path.StartsWithSegments("/admin/api"))
    {
        var userId = context.User?.FindFirst("sub")?.Value;
        var email = context.User?.FindFirst("email")?.Value;

        if (string.IsNullOrEmpty(userId))
        {
            context.Response.StatusCode = 401;
            await context.Response.WriteAsync("{\"error\":\"Not authenticated\"}");
            return;
        }

        var isAdmin = false;
        try
        {
            var db = context.RequestServices.GetRequiredService<IGameDB>();
            var admins = await db.GetAll<AdminUser>();

            // 기존 유저 찾기 (UUID 또는 이메일)
            var me = admins.FirstOrDefault(a => a.user_id == userId)
                  ?? admins.FirstOrDefault(a =>
                      string.Equals(a.email, email, StringComparison.OrdinalIgnoreCase));

            if (me != null)
            {
                // UUID 미등록이면 채움
                if (string.IsNullOrEmpty(me.user_id)) { me.user_id = userId; await db.Save(me); }
                // role이 admin이면 통과
                isAdmin = me.role == "admin";
            }
            else
            {
                // 미등록 유저 → 자동 등록
                var isFirst = admins.Count == 0;
                try
                {
                    await db.Save(new AdminUser
                    {
                        id = Guid.NewGuid().ToString(),
                        user_id = userId,
                        email = email,
                        role = isFirst ? "admin" : "pending",
                        memo = isFirst ? "first admin" : "",
                        created_at = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(),
                        created_by = isFirst ? "auto" : ""
                    });
                    isAdmin = isFirst;
                    Console.WriteLine($"[Admin] 자동 등록: {email ?? userId} → {(isFirst ? "admin" : "pending")}");
                }
                catch (Exception regEx)
                {
                    Console.WriteLine($"[Admin] 자동 등록 실패: {regEx.Message}");
                }
            }
        }
        catch (Exception adminEx)
        {
            // Exception.ToString()은 message + type + full stack trace 포함 — 정확한 발생 라인 추적용
            Console.WriteLine($"[Admin] 인증 체크 실패: {adminEx}");

            // Fallback: Dapper reflection 우회 — admin_user에 본인 row + role=admin이면 통과
            // (DapperGameDB.GetAll/Save가 어떤 이유로 throw해도 admin 사용자는 막히지 않게 안전망)
            try
            {
                using var conn = new Npgsql.NpgsqlConnection(connectionString);
                await conn.OpenAsync();
                using var cmd = new Npgsql.NpgsqlCommand(
                    "SELECT role FROM admin_user WHERE user_id = @uid LIMIT 1", conn);
                cmd.Parameters.AddWithValue("uid", userId);
                var role = await cmd.ExecuteScalarAsync() as string;
                isAdmin = role == "admin";
                if (isAdmin) Console.WriteLine($"[Admin] Fallback 통과: {userId}");
            }
            catch (Exception fbEx) { Console.WriteLine($"[Admin] Fallback 실패: {fbEx.Message}"); }
        }

        if (!isAdmin)
        {
            context.Response.StatusCode = 403;
            await context.Response.WriteAsync("{\"error\":\"Pending approval\"}");
            return;
        }
    }
    await next();
});

// ── Supabase Management API 프록시 ────────────────────────────────────
// 어드민 웹이 OAuth 프로바이더를 직접 켜지 못하는 이유는 두 가지다.
//   1) api.supabase.com 의 CORS 는 https://supabase.com 오리진만 허용한다. 브라우저는 막힌다.
//   2) PAT 는 Supabase **계정 전체**의 마스터키라 브라우저에 내려보내면 안 된다.
// 그래서 서버가 대신 부른다. 서버는 CORS 를 안 받고, PAT 는 여기서만 머문다.
//
// 인가는 위의 /admin/api 미들웨어가 이미 했다 — 여기 도달했으면 role='admin' 이다.

// PAT 는 suparun_secret 에 있다(Unity 가 올린다). 서버는 DB 소유자로 붙으므로 RLS 를 지나간다.
async Task<string?> ReadAccessToken()
{
    using var conn = new Npgsql.NpgsqlConnection(connectionString);
    await conn.OpenAsync();
    using var cmd = new Npgsql.NpgsqlCommand(
        "SELECT value FROM suparun_secret WHERE key = 'supabase_access_token' LIMIT 1", conn);
    return await cmd.ExecuteScalarAsync() as string;
}

// Supabase 의 auth config 필드 이름. Unity 의 AuthProviderGuide.GetApiFieldPrefix 와 같아야 한다.
static string? FieldPrefix(string provider) => provider?.ToLowerInvariant() switch
{
    "google" => "external_google",
    "apple" => "external_apple",
    "facebook" => "external_facebook",
    "discord" => "external_discord",
    "twitter" => "external_twitter",
    "kakao" => "external_kakao",
    "twitch" => "external_twitch",
    "spotify" => "external_spotify",
    "slack" => "external_slack_oidc",
    "github" => "external_github",
    _ => null   // Guest/GPGS/GameCenter 는 웹 로그인 수단이 아니다
};

app.MapGet("/admin/api/supabase/auth-config", async (IHttpClientFactory http, IConfiguration cfg) =>
{
    var token = await ReadAccessToken();
    if (string.IsNullOrEmpty(token))
        return Results.Json(new { error = "Access Token 이 DB 에 없습니다. Unity 에서 [올리기] 를 먼저 하세요." }, statusCode: 409);

    var projectRef = cfg["Supabase:ProjectRef"];
    var client = http.CreateClient();
    var req = new HttpRequestMessage(HttpMethod.Get, $"https://api.supabase.com/v1/projects/{projectRef}/config/auth");
    req.Headers.Add("Authorization", $"Bearer {token}");
    var res = await client.SendAsync(req);
    var body = await res.Content.ReadAsStringAsync();
    if (!res.IsSuccessStatusCode) return Results.Content(body, "application/json", null, (int)res.StatusCode);

    // **secret 이 들어 있는 필드는 지운다.** Supabase 는 client secret 을 그대로 돌려주는데,
    // 그대로 흘리면 브라우저에 내려보내지 않으려던 노력이 여기서 전부 무너진다.
    using var doc = System.Text.Json.JsonDocument.Parse(body);
    var safe = new Dictionary<string, object?>();
    foreach (var p in doc.RootElement.EnumerateObject())
    {
        if (p.Name.Contains("secret", StringComparison.OrdinalIgnoreCase)) continue;
        if (!p.Name.StartsWith("external_")) continue;
        safe[p.Name] = p.Value.ValueKind switch
        {
            // 첫 갈래에 캐스팅을 붙인다 — bool/string/null 이 섞여 공통 타입이 안 잡힌다
            System.Text.Json.JsonValueKind.True => (object?)true,
            System.Text.Json.JsonValueKind.False => false,
            System.Text.Json.JsonValueKind.String => p.Value.GetString(),
            _ => null
        };
    }
    return Results.Json(safe);
});

app.MapPost("/admin/api/supabase/auth-config", async (
    AuthProviderPatch patch, IHttpClientFactory http, IConfiguration cfg) =>
{
    var prefix = FieldPrefix(patch.provider);
    if (prefix == null)
        return Results.Json(new { error = $"'{patch.provider}' 는 웹 로그인 프로바이더가 아닙니다." }, statusCode: 400);

    var token = await ReadAccessToken();
    if (string.IsNullOrEmpty(token))
        return Results.Json(new { error = "Access Token 이 DB 에 없습니다. Unity 에서 [올리기] 를 먼저 하세요." }, statusCode: 409);

    // 통째로 받아 넘기지 않고 필요한 필드만 조립한다 — 이 엔드포인트로 site_url 같은
    // 다른 설정까지 바뀌면 원인을 찾을 수 없는 사고가 된다.
    var fields = new Dictionary<string, object> { [$"{prefix}_enabled"] = patch.enabled };
    if (patch.enabled)
    {
        if (string.IsNullOrWhiteSpace(patch.clientId))
            return Results.Json(new { error = "Client ID 가 비어 있습니다." }, statusCode: 400);
        fields[$"{prefix}_client_id"] = patch.clientId;
        // secret 은 비어 있으면 건드리지 않는다 — 화면에 안 보여주므로 "그대로 두기" 가 기본이어야 한다.
        if (!string.IsNullOrWhiteSpace(patch.secret)) fields[$"{prefix}_secret"] = patch.secret;
        fields[$"{prefix}_skip_nonce_check"] = true;
    }

    var projectRef = cfg["Supabase:ProjectRef"];
    var client = http.CreateClient();
    var req = new HttpRequestMessage(HttpMethod.Patch, $"https://api.supabase.com/v1/projects/{projectRef}/config/auth")
    {
        Content = new StringContent(System.Text.Json.JsonSerializer.Serialize(fields),
            System.Text.Encoding.UTF8, "application/json")
    };
    req.Headers.Add("Authorization", $"Bearer {token}");
    var res = await client.SendAsync(req);
    var body = await res.Content.ReadAsStringAsync();
    if (!res.IsSuccessStatusCode)
        return Results.Content(body, "application/json", null, (int)res.StatusCode);

    // 어드민의 잠금 여부는 suparun_meta.auth_config 가 정한다. 여기서 같이 갱신하지 않으면
    // 프로바이더를 켰는데도 Unity 가 다음에 기록할 때까지 어드민이 열린 채로 남는다.
    await SyncAuthConfigMeta(token, projectRef, http);
    return Results.Json(new { ok = true });
});

// Supabase 에서 현재 켜져 있는 웹 프로바이더 목록을 읽어 meta 에 적는다.
// Supabase 를 다시 읽는 이유: 방금 보낸 것만 반영하면 다른 경로(Unity·Supabase 대시보드)로
// 바뀐 것과 어긋난다. 실제 상태를 근거로 삼는다.
async Task SyncAuthConfigMeta(string token, string? projectRef, IHttpClientFactory http)
{
    try
    {
        var client = http.CreateClient();
        var req = new HttpRequestMessage(HttpMethod.Get,
            $"https://api.supabase.com/v1/projects/{projectRef}/config/auth");
        req.Headers.Add("Authorization", $"Bearer {token}");
        var res = await client.SendAsync(req);
        if (!res.IsSuccessStatusCode) return;

        using var doc = System.Text.Json.JsonDocument.Parse(await res.Content.ReadAsStringAsync());
        var enabled = new List<string>();
        foreach (var p in doc.RootElement.EnumerateObject())
        {
            if (!p.Name.StartsWith("external_") || !p.Name.EndsWith("_enabled")) continue;
            if (p.Value.ValueKind != System.Text.Json.JsonValueKind.True) continue;
            var name = p.Name["external_".Length..^"_enabled".Length];
            // anonymous(=Guest) 는 웹 로그인 버튼이 아니다. 이걸 세면 로그인 수단이 하나도
            // 없는 채로 어드민이 잠겨 아무도 못 들어온다.
            if (name is "anonymous_users" or "anonymous") continue;
            enabled.Add(name);
        }

        var payload = System.Text.Json.JsonSerializer.Serialize(new { providers = enabled });
        using var conn = new Npgsql.NpgsqlConnection(connectionString);
        await conn.OpenAsync();
        using var cmd = new Npgsql.NpgsqlCommand(
            "INSERT INTO suparun_meta(key, value, updated_at) VALUES ('auth_config', @v::jsonb, now()) " +
            "ON CONFLICT (key) DO UPDATE SET value = EXCLUDED.value, updated_at = now()", conn);
        cmd.Parameters.AddWithValue("v", payload);
        await cmd.ExecuteNonQueryAsync();
    }
    catch (Exception ex)
    {
        // 실패해도 프로바이더 설정 자체는 이미 반영됐다. 잠금이 한 박자 늦을 뿐이라 막지 않는다.
        Console.WriteLine($"[Auth] auth_config 갱신 실패: {ex.Message}");
    }
}

app.MapControllers();
app.MapGet("/health", () => "OK");
app.Run();

/// <summary>어드민이 보내는 프로바이더 설정. secret 은 저장만 하고 절대 되돌려주지 않는다.</summary>
record AuthProviderPatch(string provider, string clientId, string secret, bool enabled);
