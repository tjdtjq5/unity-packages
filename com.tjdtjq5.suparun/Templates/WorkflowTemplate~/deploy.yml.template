name: Deploy to Cloud Run
on:
  push:
    branches: [main]
  workflow_dispatch:
    inputs:
      # 릴리스 오케스트레이션(#51)이 지정한다. 비우면 커밋 기반 태그(rel-<sha7>)가 붙는다.
      release_tag:
        description: 'Cloud Run 리비전 태그 (소문자·숫자·하이픈)'
        required: false
        default: ''
      # true 면 트래픽 0% 로 배포 — 태그 URL 로 먼저 검증하고, 전환은 오케스트레이션이 한다.
      no_traffic:
        description: '트래픽 전환 없이 배포 (검증용)'
        required: false
        default: 'false'

env:
  GAR_REGION: ${{ secrets.CLOUD_RUN_REGION }}
  GAR_REPO: server-images
  IMAGE_NAME: ${{ secrets.CLOUD_RUN_SERVICE }}

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: google-github-actions/auth@v2
        with:
          credentials_json: ${{ secrets.GCP_SA_KEY }}

      - name: Set up Cloud SDK
        uses: google-github-actions/setup-gcloud@v2

      - name: Get GCP project ID
        id: project
        run: echo "id=$(gcloud config get-value project)" >> $GITHUB_OUTPUT

      - name: Create Artifact Registry (if not exists)
        run: |
          gcloud artifacts repositories describe ${{ env.GAR_REPO }} \
            --location=${{ env.GAR_REGION }} 2>/dev/null || \
          gcloud artifacts repositories create ${{ env.GAR_REPO }} \
            --repository-format=docker \
            --location=${{ env.GAR_REGION }}

      - name: Configure Docker for GAR
        run: gcloud auth configure-docker ${{ env.GAR_REGION }}-docker.pkg.dev --quiet

      - name: Build and push with cache
        run: |
          IMAGE=${{ env.GAR_REGION }}-docker.pkg.dev/${{ steps.project.outputs.id }}/${{ env.GAR_REPO }}/${{ env.IMAGE_NAME }}
          docker build \
            --cache-from $IMAGE:cache \
            --build-arg BUILDKIT_INLINE_CACHE=1 \
            -t $IMAGE:latest \
            -t $IMAGE:cache \
            .
          docker push $IMAGE:latest
          docker push $IMAGE:cache
        env:
          DOCKER_BUILDKIT: 1

      # 릴리스 태그 (#49, ADR-0010 결정 8) — 리비전마다 식별자가 붙는다.
      # 릴리스↔리비전 매핑, non-addressable 리비전 1000개 자동 삭제 회피, 태그 URL 확보가 목적.
      - name: Resolve release tag and flags
        id: rel
        # 입력은 env 로 간접화한다 — `${{ }}` 를 run 스크립트에 직접 보간하면 입력값이
        # 셸 코드로 해석되는 스크립트 인젝션 표면이 된다(GitHub 문서의 권고 패턴).
        env:
          INPUT_TAG: ${{ github.event.inputs.release_tag }}
          INPUT_NO_TRAFFIC: ${{ github.event.inputs.no_traffic }}
        run: |
          TAG="$INPUT_TAG"
          if [ -z "$TAG" ]; then TAG="rel-${GITHUB_SHA::7}"; fi
          case "$TAG" in (*[!a-z0-9-]*) echo "잘못된 태그: $TAG (소문자·숫자·하이픈만)"; exit 1;; esac
          FLAGS="--allow-unauthenticated --tag $TAG --min-instances ${{ secrets.CLOUD_RUN_MIN_INSTANCES || 0 }} --max-instances ${{ secrets.CLOUD_RUN_MAX_INSTANCES || 3 }}"
          if [ "$INPUT_NO_TRAFFIC" = "true" ]; then FLAGS="$FLAGS --no-traffic"; fi
          echo "tag=$TAG" >> $GITHUB_OUTPUT
          echo "flags=$FLAGS" >> $GITHUB_OUTPUT

      - name: Deploy to Cloud Run
        uses: google-github-actions/deploy-cloudrun@v2
        with:
          service: ${{ secrets.CLOUD_RUN_SERVICE }}
          region: ${{ secrets.CLOUD_RUN_REGION }}
          image: ${{ env.GAR_REGION }}-docker.pkg.dev/${{ steps.project.outputs.id }}/${{ env.GAR_REPO }}/${{ env.IMAGE_NAME }}:latest
          flags: ${{ steps.rel.outputs.flags }}
          env_vars: |
            ConnectionStrings__Supabase=${{ secrets.SUPABASE_CONNECTION_STRING }}
            Supabase__AuthUrl=${{ secrets.SUPABASE_AUTH_URL }}
            CRON_SECRET=${{ secrets.CRON_SECRET }}
